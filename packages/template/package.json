{
  "name": "@create-scaf/template",
  "version": "1.0.0",
  "description": "Template definition tools, interfaces, and prompts for create-scaf",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./inquirer": {
      "types": "./dist/inquirer.d.ts",
      "import": "./dist/inquirer.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.3.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  }
}
